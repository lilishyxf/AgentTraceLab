{
  "schema_version": "agenttracelab.deepresearch-benchmark.v1",
  "benchmark_id": "deepresearch-disposition-isolation-regression",
  "version": "0.1.0",
  "description": "Focused live regression for pre-retrieval clarification/refusal decisions, evaluation isolation, and one normal official-source retrieval control.",
  "evidence_class": "live-system",
  "target_name": "deepresearch-agent-harness",
  "target_revision": null,
